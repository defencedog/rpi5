+			var format = new GdkPixbuf.Internal.PixbufFormatUnownedHandle (GLib.Internal.SList.NthData (list, i));
 			result[i] = new PixbufFormat (GdkPixbuf.Internal.PixbufFormat.Copy (format));
 		}
 
 		return result;
